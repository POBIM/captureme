{
  "name": "captureme-marketing",
  "private": true,
  "version": "1.0.0",
  "description": "CaptureME posters, social cards and tutorial video (Remotion) built from REAL app captures. Separate from the app.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --public-dir=../docs/images",
    "sync": "node scripts/sync-from-app.mjs && node scripts/gen-qr.mjs",
    "capture": "bash capture/run-all.sh",
    "capture:docs": "node capture/docs-images.mjs th && node capture/docs-images.mjs en",
    "render": "node scripts/render-all.mjs",
    "render:posters": "node scripts/render-all.mjs posters",
    "render:cards": "node scripts/render-all.mjs cards",
    "render:video": "node scripts/render-all.mjs video",
    "render:short": "node scripts/render-all.mjs short",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.1.0",
    "@remotion/cli": "4.0.290",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.69.0",
    "typescript": "^5.6.0",
    "@remotion/bundler": "4.0.290",
    "@remotion/renderer": "4.0.290"
  }
}
